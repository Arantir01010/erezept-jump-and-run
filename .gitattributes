# Zeilenenden: im Repository immer LF (Stand heute ist das Repo bereits
# vollständig LF-normalisiert — diese Datei hält das auf jedem Rechner so
# und beendet das "LF will be replaced by CRLF"-Rauschen unter Windows).
* text=auto

# Batchdateien sind in diesem Repo seit jeher reines LF (Arbeitskopie wie Blob)
# und laufen so am Messe-PC. WICHTIG: eol=lf statt eol=crlf, denn der
# Kern-Guard (tools/check-core.ts) hasht Datei-Bytes — jede Plattform muss
# exakt dieselben Bytes auschecken, sonst schlägt npm run validate in der CI an.
*.bat text eol=lf

# Binärdateien nie anfassen
*.png binary
*.jpg binary
*.tgz binary
*.bundle binary
